/**
 * @file Firestore Security Rules
 * @description This ruleset authenticates the user and allows full access.
 *
 * Core Philosophy:
 * This ruleset authenticates the user and allows full access
 *
 * Data Structure:
 * - /teams/{teamId}: Stores team information.
 * - /users/{userId}: Stores user profiles.
 * - /locations/{locationId}: Stores location information.
 * - /auditLogs/{logId}: Stores a global list of all audit trail events.
 * - /teams/{teamId}/tasks/{taskId}: Stores tasks for each team.
 * - /teams/{teamId}/recurringTasks/{recurringTaskId}: Stores recurring tasks for each team.
 * - /teams/{teamId}/categories/{categoryId}: Stores task categories for each team.
 * - /teams/{teamId}/settings/appSettings: Stores team settings.
 *
 * Key Security Decisions:
 * - User authentication is required for all operations.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows access to teams collection for authenticated users.
     * @path /teams/{teamId}
     * @allow (get) User is authenticated.
     * @deny (create) User is not authenticated.
     * @principle Allows authenticated users to read and write to the teams collection.
     */
    match /teams/{teamId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    /**
     * @description Allows access to users collection for authenticated users.
     * @path /users/{userId}
     * @allow (get) User is authenticated.
     * @deny (create) User is not authenticated.
     * @principle Allows authenticated users to read and write to the users collection.
     */
    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }
    
    /**
     * @description Manages access to the global audit log.
     * @path /auditLogs/{logId}
     * @allow (get, list) User is an Admin.
     * @allow (create) Any signed-in user can create a log entry.
     * @principle Only Admins can read the audit log. All authenticated users can create entries.
     */
    match /auditLogs/{logId} {
      allow get, list: if getUserRole(request.auth.uid) == 'Admin';
      allow create: if isSignedIn();
      allow update, delete: if false; // Logs are immutable
    }

    /**
     * @description Allows access to locations collection for authenticated users.
     * @path /locations/{locationId}
     * @allow (get) User is authenticated.
     * @deny (create) User is not authenticated.
     * @principle Allows authenticated users to read and write to the locations collection.
     */
    match /locations/{locationId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    /**
     * @description Allows access to tasks collection for authenticated users.
     * @path /teams/{teamId}/tasks/{taskId}
     * @allow (get) User is authenticated.
     * @deny (create) User is not authenticated.
     * @principle Allows authenticated users to read and write to the tasks collection.
     */
    match /teams/{teamId}/tasks/{taskId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    /**
     * @description Allows access to recurringTasks collection for authenticated users.
     * @path /teams/{teamId}/recurringTasks/{recurringTaskId}
     * @allow (get) User is authenticated.
     * @deny (create) User is not authenticated.
     * @principle Allows authenticated users to read and write to the recurringTasks collection.
     */
    match /teams/{teamId}/recurringTasks/{recurringTaskId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    /**
     * @description Allows access to categories collection for authenticated users.
     * @path /teams/{teamId}/categories/{categoryId}
     * @allow (get) User is authenticated.
     * @deny (create) User is not authenticated.
     * @principle Allows authenticated users to read and write to the categories collection.
     */
    match /teams/{teamId}/categories/{categoryId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    /**
     * @description Allows access to appSettings document for authenticated users.
     * @path /teams/{teamId}/settings/appSettings
     * @allow (get) User is authenticated.
     * @deny (create) User is not authenticated.
     * @principle Allows authenticated users to read and write to the appSettings document.
     */
    match /teams/{teamId}/settings/appSettings {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    function isSignedIn() {
        return request.auth != null;
    }
    
    function getUserRole(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.role;
    }
  }
}
