rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /teams/{teamId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }
    
    match /locations/{locationId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    match /teams/{teamId}/tasks/{taskId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    match /teams/{teamId}/recurringTasks/{recurringTaskId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    match /teams/{teamId}/categories/{categoryId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    match /teams/{teamId}/settings/appSettings {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }
    
    // Allow access to global configuration and versioning
    match /settings/global {
      allow get: if true; // Public read allowed for version checking even if not signed in
      allow write: if isSignedIn(); // In production, restrict this to Admins
    }

    function isSignedIn() {
        return request.auth != null;
    }
  }
}