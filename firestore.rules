/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict user-ownership model for user profiles
 * and allows public read access to tasks, recurring tasks, locations, and categories.
 * System settings are publicly readable but only writable by authenticated users.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles, accessible only by the owner.
 * - /tasks/{taskId}: Stores tasks, publicly readable, owner-only write.
 * - /recurringTasks/{recurringTaskId}: Stores recurring tasks, publicly readable, owner-only write.
 * - /locations/{locationId}: Stores locations, publicly readable. owner-only write
 * - /categories/{categoryId}: Stores categories, publicly readable, owner-only write.
 * - /settings/appSettings: Stores app settings, publicly readable, authenticated-user write.
 *
 * Key Security Decisions:
 * - User listing is explicitly denied.
 * - Tasks, recurringTasks, locations and categories are publicly readable but require authentication for write operations.
 * - Write operations for tasks, recurringTasks, locations and categories, are restricted to authenticated users.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secures user profiles. Only the owner can read and write their own profile.
     * @path /users/{userId}
     * @allow (create) User with uid "user123" can create their profile.
     * @deny (create) User with uid "user456" cannot create a profile with ID "user123".
     * @allow (get, update, delete) User with uid "user123" can read, update and delete their own profile.
     * @deny (get, update, delete) User with uid "user456" cannot read, update or delete the profile with ID "user123".
     * @principle Enforces document ownership for reads and writes. Validates user ID consistency.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Secures tasks. Allows public read access, but restricts write access to authenticated users.
     * @path /tasks/{taskId}
     * @allow (get, list) Any user can read and list tasks.
     * @allow (create) Authenticated user can create a task.
     * @deny (create) Unauthenticated user cannot create a task.
     * @allow (update, delete) Authenticated user can update and delete an existing task.
     * @deny (update, delete) Unauthenticated user cannot update or delete a task.
     * @principle Allows public read access with owner-only writes.
     */
    match /tasks/{taskId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Secures recurring tasks. Allows public read access, but restricts write access to authenticated users.
     * @path /recurringTasks/{recurringTaskId}
     * @allow (get, list) Any user can read and list recurring tasks.
     * @allow (create) Authenticated user can create a recurring task.
     * @deny (create) Unauthenticated user cannot create a recurring task.
     * @allow (update, delete) Authenticated user can update and delete an existing recurring task.
     * @deny (update, delete) Unauthenticated user cannot update or delete a recurring task.
     * @principle Allows public read access with owner-only writes.
     */
    match /recurringTasks/{recurringTaskId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Secures locations. Allows public read access, but restricts write access to authenticated users.
     * @path /locations/{locationId}
     * @allow (get, list) Any user can read and list locations.
     * @allow (create) Authenticated user can create a location.
     * @deny (create) Unauthenticated user cannot create a location.
     * @allow (update, delete) Authenticated user can update and delete an existing location.
     * @deny (update, delete) Unauthenticated user cannot update or delete a location.
     * @principle Allows public read access with owner-only writes.
     */
    match /locations/{locationId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Secures categories. Allows public read access, but restricts write access to authenticated users.
     * @path /categories/{categoryId}
     * @allow (get, list) Any user can read and list categories.
     * @allow (create) Authenticated user can create a category.
     * @deny (create) Unauthenticated user cannot create a category.
     * @allow (update, delete) Authenticated user can update and delete an existing category.
     * @deny (update, delete) Unauthenticated user cannot update or delete a category.
     * @principle Allows public read access with owner-only writes.
     */
    match /categories/{categoryId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Secures app settings. Allows public read access, but restricts write access to authenticated users.
     * @path /settings/appSettings
     * @allow (get) Any user can read the app settings.
     * @allow (create) Authenticated user can create the app settings (first time).
     * @deny (create) Unauthenticated user cannot create the app settings.
     * @allow (update) Authenticated user can update the existing app settings.
     * @deny (update) Unauthenticated user cannot update the app settings.
     * @allow (delete) Authenticated user can delete the app settings.
     * @deny (delete) Unauthenticated user cannot delete the app settings.
     * @principle Allows public read access with owner-only writes.
     */
    match /settings/appSettings {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
      allow list: if false;
    }
  }
}