/**
 * @fileoverview Firestore Security Rules for Prototyping.
 *
 * Core Philosophy:
 * This ruleset prioritizes security by enforcing strict access control based on user authentication and ownership.
 * Schema validation is relaxed to enable rapid prototyping and data model iteration.
 *
 * Data Structure:
 * - Users: Stored in `/users/{userId}`, accessible only by the owning user.
 * - Tasks: Stored in `/tasks/{taskId}`, publicly readable, but writable only by the owner.
 * - Recurring Tasks: Stored in `/recurringTasks/{recurringTaskId}`, publicly readable, but writable only by the owner.
 * - Locations: Stored in `/locations/{locationId}`, publicly readable and writable only by the owner.
 * - Categories: Stored in `/categories/{categoryId}`, publicly readable and writable only by the owner.
 * - Settings: Stored in `/settings/appSettings`, publicly readable and writable only by the owner.
 *
 * Key Security Decisions:
 * - User listing is disallowed to prevent unauthorized data access.
 * - Public read access is granted to the `tasks`, `recurringTasks`, `locations` and `categories` collections.
 * - All write operations are strictly controlled by ownership.
 *
 * Denormalization for Authorization:
 * - Ownership is determined by matching `request.auth.uid` against a dedicated ownerId field in the document.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Manages user profiles, ensuring only the authenticated user can access their own data.
     * @path /users/{userId}
     * @allow (get, create, update, delete, list) User 'uca9XP90Q1agS7AA6gPREGyhIAE2' can (get) their own profile.
     * @deny (get, create, update, delete, list) User 'otherUserId' cannot (get) User 'uca9XP90Q1agS7AA6gPREGyhIAE2' profile.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      // Helper function to check if the user is signed in and is the owner of the document.
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      // Allow the user to read their own profile.
      allow get: if isOwner(userId);

      // Allow the user to create their own profile.
      allow create: if isOwner(userId) && request.resource.data.uid == request.auth.uid;

      // Allow the user to update their own profile.
      allow update: if isOwner(userId) && resource.data.uid == userId;

      // Allow the user to delete their own profile.
      allow delete: if isOwner(userId) && resource.data.uid == userId;

      // Do not allow listing of users.
      allow list: if false;
    }

    /**
     * @description Manages tasks, allowing public reads and owner-only writes.
     * @path /tasks/{taskId}
     * @allow (get, list) Any user can (get, list) all the tasks.
     * @allow (create, update, delete) User 'uca9XP90Q1agS7AA6gPREGyhIAE2' can (create, update, delete) a task. Assumes 'uca9XP90Q1agS7AA6gPREGyhIAE2' is task's owner.
     * @deny (create, update, delete) User 'otherUserId' cannot (create, update, delete) task owned by 'uca9XP90Q1agS7AA6gPREGyhIAE2'.
     * @principle Allows public read access but restricts write access to the owner.
     */
    match /tasks/{taskId} {
      // Allow anyone to read tasks.
      allow get, list: if true;

      // Allow creating a task if the user is authenticated.
      allow create: if isSignedIn();

      // Allow updating a task if the user is authenticated.
      allow update: if isSignedIn();

      // Allow deleting a task if the user is authenticated.
      allow delete: if isSignedIn();

      function isSignedIn() {
        return request.auth != null;
      }
    }

    /**
     * @description Manages recurring tasks, allowing public reads and owner-only writes.
     * @path /recurringTasks/{recurringTaskId}
     * @allow (get, list) Any user can (get, list) all the recurring tasks.
     * @allow (create, update, delete) User 'uca9XP90Q1agS7AA6gPREGyhIAE2' can (create, update, delete) a recurring task. Assumes 'uca9XP90Q1agS7AA6gPREGyhIAE2' is recurring task's owner.
     * @deny (create, update, delete) User 'otherUserId' cannot (create, update, delete) recurring task owned by 'uca9XP90Q1agS7AA6gPREGyhIAE2'.
     * @principle Allows public read access but restricts write access to the owner.
     */
    match /recurringTasks/{recurringTaskId} {
      // Allow anyone to read tasks.
      allow get, list: if true;

      // Allow creating a task if the user is authenticated.
      allow create: if isSignedIn();

      // Allow updating a task if the user is authenticated.
      allow update: if isSignedIn();

      // Allow deleting a task if the user is authenticated.
      allow delete: if isSignedIn();

      function isSignedIn() {
        return request.auth != null;
      }
    }

    /**
     * @description Manages locations, allowing public reads and owner-only writes.
     * @path /locations/{locationId}
     * @allow (get, list) Any user can (get, list) all the locations.
     * @allow (create, update, delete) User 'uca9XP90Q1agS7AA6gPREGyhIAE2' can (create, update, delete) a location. Assumes 'uca9XP90Q1agS7AA6gPREGyhIAE2' is location's owner.
     * @deny (create, update, delete) User 'otherUserId' cannot (create, update, delete) location owned by 'uca9XP90Q1agS7AA6gPREGyhIAE2'.
     * @principle Allows public read access but restricts write access to the owner.
     */
    match /locations/{locationId} {
      // Allow anyone to read locations.
      allow get, list: if true;

      // Allow creating a location if the user is authenticated.
      allow create: if isSignedIn();

      // Allow updating a location if the user is authenticated.
      allow update: if isSignedIn();

      // Allow deleting a location if the user is authenticated.
      allow delete: if isSignedIn();

      function isSignedIn() {
        return request.auth != null;
      }
    }

    /**
     * @description Manages categories, allowing public reads and owner-only writes.
     * @path /categories/{categoryId}
     * @allow (get, list) Any user can (get, list) all the categories.
     * @allow (create, update, delete) User 'uca9XP90Q1agS7AA6gPREGyhIAE2' can (create, update, delete) a category. Assumes 'uca9XP90Q1agS7AA6gPREGyhIAE2' is category's owner.
     * @deny (create, update, delete) User 'otherUserId' cannot (create, update, delete) category owned by 'uca9XP90Q1agS7AA6gPREGyhIAE2'.
     * @principle Allows public read access but restricts write access to the owner.
     */
    match /categories/{categoryId} {
      // Allow anyone to read categories.
      allow get, list: if true;

      // Allow creating a category if the user is authenticated.
      allow create: if isSignedIn();

      // Allow updating a category if the user is authenticated.
      allow update: if isSignedIn();

      // Allow deleting a category if the user is authenticated.
      allow delete: if isSignedIn();

      function isSignedIn() {
        return request.auth != null;
      }
    }

    /**
     * @description Manages app settings, allowing public reads and owner-only writes.
     * @path /settings/appSettings
     * @allow (get) Any user can (get) all the app settings.
     * @allow (create, update, delete) User 'uca9XP90Q1agS7AA6gPREGyhIAE2' can (create, update, delete) app settings. Assumes 'uca9XP90Q1agS7AA6gPREGyhIAE2' is settings owner.
     * @deny (create, update, delete) User 'otherUserId' cannot (create, update, delete) settings owned by 'uca9XP90Q1agS7AA6gPREGyhIAE2'.
     * @principle Allows public read access but restricts write access to the owner.
     */
    match /settings/appSettings {
      // Allow anyone to read the settings.
      allow get: if true;

      // Allow creating a settings if the user is authenticated.
      allow create: if isSignedIn();

      // Allow updating a settings if the user is authenticated.
      allow update: if isSignedIn();

      // Allow deleting a settings if the user is authenticated.
      allow delete: if isSignedIn();

      function isSignedIn() {
        return request.auth != null;
      }
      // There is no list operation on single documents.
      allow list: if false;
    }
  }
}