/**
 * @fileoverview Firestore Security Rules for Facility Maintenance App.
 *
 * Core Philosophy:
 * This ruleset enforces role-based access control.  Users are assigned roles (Admin, Staff, Viewer),
 * and permissions are granted based on these roles.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles. Access is restricted based on role.
 * - /tasks/{taskId}: Stores facility tasks. Access is restricted based on role.
 * - /recurringTasks/{recurringTaskId}: Stores recurring tasks. Access is restricted based on role.
 * - /locations/{locationId}: Stores facility locations. Access is restricted based on role.
 * - /categories/{categoryId}: Stores task categories. Access is restricted based on role.
 * - /settings/appSettings: Stores system settings. Only Admins can modify.
 *
 * Key Security Decisions:
 * - Users collection can be read only by admins and staff.
 * - Only admins can create, update, or delete settings.
 * - All other collections can be read and write by admin and staff.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Manages user profiles. Only admins and staff can read users data.
     * @path /users/{userId}
     * @allow (get, list) User with role admin or staff can access user data.
     * @deny (get, list) User with role viewer cannot access user data.
     * @allow (create) User with role admin or staff can create user data.
     * @deny (create) User with role viewer cannot create user data.
     * @allow (update) User with role admin or staff can update user data.
     * @deny (update) User with role viewer cannot update user data.
     * @allow (delete) User with role admin or staff can delete user data.
     * @deny (delete) User with role viewer cannot delete user data.
     * @principle Enforces role-based access control for user profiles.
     */
    match /users/{userId} {
      allow get, list: if isAdmin() || isStaff();
      allow create, update, delete: if isAdmin() || isStaff();
    }

    /**
     * @description Manages facility tasks. Only admins and staff can manage tasks.
     * @path /tasks/{taskId}
     * @allow (get, list) User with role admin or staff can access task data.
     * @deny (get, list) User with role viewer cannot access task data.
     * @allow (create) User with role admin or staff can create task data.
     * @deny (create) User with role viewer cannot create task data.
     * @allow (update) User with role admin or staff can update task data.
     * @deny (update) User with role viewer cannot update task data.
     * @allow (delete) User with role admin or staff can delete task data.
     * @deny (delete) User with role viewer cannot delete task data.
     * @principle Enforces role-based access control for facility tasks.
     */
    match /tasks/{taskId} {
      allow get, list: if isAdmin() || isStaff();
      allow create, update, delete: if isAdmin() || isStaff();
    }

    /**
     * @description Manages recurring tasks. Only admins and staff can manage recurring tasks.
     * @path /recurringTasks/{recurringTaskId}
     * @allow (get, list) User with role admin or staff can access recurring task data.
     * @deny (get, list) User with role viewer cannot access recurring task data.
     * @allow (create) User with role admin or staff can create recurring task data.
     * @deny (create) User with role viewer cannot create user data.
     * @allow (update) User with role admin or staff can update recurring task data.
     * @deny (update) User with role viewer cannot update recurring task data.
     * @allow (delete) User with role admin or staff can delete recurring task data.
     * @deny (delete) User with role viewer cannot delete recurring task data.
     * @principle Enforces role-based access control for recurring tasks.
     */
    match /recurringTasks/{recurringTaskId} {
      allow get, list: if isAdmin() || isStaff();
      allow create, update, delete: if isAdmin() || isStaff();
    }

    /**
     * @description Manages facility locations. Only admins and staff can manage facility locations.
     * @path /locations/{locationId}
     * @allow (get, list) User with role admin or staff can access location data.
     * @deny (get, list) User with role viewer cannot access location data.
     * @allow (create) User with role admin or staff can create location data.
     * @deny (create) User with role viewer cannot create user data.
     * @allow (update) User with role admin or staff can update location data.
     * @deny (update) User with role viewer cannot update location data.
     * @allow (delete) User with role admin or staff can delete location data.
     * @deny (delete) User with role viewer cannot delete location data.
     * @principle Enforces role-based access control for facility locations.
     */
    match /locations/{locationId} {
      allow get, list: if isAdmin() || isStaff();
      allow create, update, delete: if isAdmin() || isStaff();
    }

    /**
     * @description Manages task categories. Only admins and staff can manage categories.
     * @path /categories/{categoryId}
     * @allow (get, list) User with role admin or staff can access category data.
     * @deny (get, list) User with role viewer cannot access category data.
     * @allow (create) User with role admin or staff can create category data.
     * @deny (create) User with role viewer cannot create user data.
     * @allow (update) User with role admin or staff can update category data.
     * @deny (update) User with role viewer cannot update category data.
     * @allow (delete) User with role admin or staff can delete category data.
     * @deny (delete) User with role viewer cannot delete category data.
     * @principle Enforces role-based access control for task categories.
     */
    match /categories/{categoryId} {
      allow get, list: if isAdmin() || isStaff();
      allow create, update, delete: if isAdmin() || isStaff();
    }

    /**
     * @description Manages system-wide settings. Only admins can modify settings.
     * @path /settings/appSettings
     * @allow get: if true;
     * @allow list: if false;
     * @allow create: if isAdmin();
     * @allow update: if isAdmin();
     * @allow delete: if isAdmin();
     * @principle Restricts modification of app settings to admins only.
     */
    match /settings/{document} {
      allow get: if true;
      allow list: if false;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }

  function isSignedIn() {
    return request.auth != null;
  }

  function isAdmin() {
    return isSignedIn() && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin');
  }

  function isStaff() {
    return isSignedIn() && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Staff');
  }

  function isViewer() {
      return isSignedIn() && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Viewer');
  }

  function isOwner(userId) {
    return isSignedIn() && request.auth.uid == userId;
  }
}