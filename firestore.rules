/**
 * @fileoverview Firestore Security Rules for Prototyping.
 *
 * Core Philosophy:
 * This ruleset prioritizes rapid prototyping by granting full access to all authenticated users.
 * It is CRITICAL to replace these permissive rules with more restrictive ones before deploying to production.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles, with 'userId' matching the Firebase Auth UID.
 * - /tasks/{taskId}: Stores tasks.
 * - /recurringTasks/{recurringTaskId}: Stores recurring tasks.
 * - /locations/{locationId}: Stores locations.
 * - /categories/{categoryId}: Stores categories.
 * - /settings/appSettings: Stores app settings in a single document.
 *
 * Key Security Decisions:
 * - Authenticated users can read and write all data.
 * - These rules are temporary and should be replaced with more secure authorization logic.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants all authenticated users full access to user profiles for prototyping.
     * @path /users/{userId}
     * @allow (create, update, delete, get, list) - Any authenticated user can perform any operation.
     * @deny None - All operations are allowed for authenticated users during prototyping.
     * @principle Allows any authenticated user to read/write user profiles during prototyping.
     */
    match /users/{userId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    /**
     * @description Grants all authenticated users full access to tasks for prototyping.
     * @path /tasks/{taskId}
     * @allow (create, update, delete, get, list) - Any authenticated user can perform any operation.
     * @deny None - All operations are allowed for authenticated users during prototyping.
     * @principle Allows any authenticated user to read/write tasks during prototyping.
     */
    match /tasks/{taskId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    /**
     * @description Grants all authenticated users full access to recurring tasks for prototyping.
     * @path /recurringTasks/{recurringTaskId}
     * @allow (create, update, delete, get, list) - Any authenticated user can perform any operation.
     * @deny None - All operations are allowed for authenticated users during prototyping.
     * @principle Allows any authenticated user to read/write recurring tasks during prototyping.
     */
    match /recurringTasks/{recurringTaskId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    /**
     * @description Grants all authenticated users full access to locations for prototyping.
     * @path /locations/{locationId}
     * @allow (create, update, delete, get, list) - Any authenticated user can perform any operation.
     * @deny None - All operations are allowed for authenticated users during prototyping.
     * @principle Allows any authenticated user to read/write locations during prototyping.
     */
    match /locations/{locationId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    /**
     * @description Grants all authenticated users full access to categories for prototyping.
     * @path /categories/{categoryId}
     * @allow (create, update, delete, get, list) - Any authenticated user can perform any operation.
     * @deny None - All operations are allowed for authenticated users during prototyping.
     * @principle Allows any authenticated user to read/write categories during prototyping.
     */
    match /categories/{categoryId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    /**
     * @description Grants all authenticated users full access to app settings for prototyping.
     * @path /settings/appSettings
     * @allow (create, update, delete, get, list) - Any authenticated user can perform any operation.
     * @deny None - All operations are allowed for authenticated users during prototyping.
     * @principle Allows any authenticated user to read/write app settings during prototyping.
     */
    match /settings/appSettings {
      allow get, list: if true;
      allow create, update, delete: if true;
    }
  }
}