/**
 * @file Firebase Security Rules for Firestore.
 *
 * @core_philosophy This ruleset enforces a strict user-ownership model for user profiles
 * and public read access with owner-only writes for tasks, recurring tasks, locations and categories.
 * System settings are read-only for authenticated users.
 *
 * @data_structure
 * - /users/{userId}: Stores user profiles, accessible only by the user themselves.
 * - /tasks/{taskId}: Stores tasks, publicly readable, but only editable by the task's owner. Assumes `ownerId` or `authorId` field on each task.
 * - /recurringTasks/{recurringTaskId}: Stores recurring tasks, publicly readable, but only editable by the task's owner. Assumes `ownerId` or `authorId` field on each recurring task.
 * - /locations/{locationId}: Stores locations, publicly readable, but only editable by the location's owner. Assumes `ownerId` or `authorId` field on each location.
 * - /categories/{categoryId}: Stores categories, publicly readable, but only editable by the category's owner. Assumes `ownerId` or `authorId` field on each category.
 * - /settings/appSettings: Stores application settings, readable by all authenticated users, but not writable by anyone.
 *
 * @key_security_decisions
 * - Disallows user listing to prevent enumeration.
 * - Enforces ownership for all write operations on user profiles.
 * - Assumes the existence of `ownerId` or `authorId` fields on Task, RecurringTask, Location, and Category entities for owner-only write access.
 * - Settings document is read-only.
 *
 * @denormalization_for_authorization
 * - Tasks, RecurringTasks, Locations, and Categories should include an `ownerId` or `authorId` field to simplify owner-based authorization.
 *
 * @structural_segregation
 * - Uses separate collections for user profiles and other data to maintain clear access boundaries.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants access only to the user with the matching UID.
     * @path /users/{userId}
     * @allow (create) User with UID 'user123' can create their profile.
     * @allow (get) User with UID 'user123' can read their profile.
     * @allow (update) User with UID 'user123' can update their profile.
     * @allow (delete) User with UID 'user123' can delete their profile.
     * @deny (create) User with UID 'user456' cannot create a profile for 'user123'.
     * @deny (get) User with UID 'user456' cannot read the profile of 'user123'.
     * @deny (update) User with UID 'user456' cannot update the profile of 'user123'.
     * @deny (delete) User with UID 'user456' cannot delete the profile of 'user123'.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if false; // Prevent user enumeration

      allow create: if isOwner(userId) && request.resource.data.uid == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.uid == resource.data.uid; // Enforce immutable uid
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Grants public read access and owner-only write access to tasks.
     * @path /tasks/{taskId}
     * @allow (get) Any user can read any task.
     * @allow (list) Any user can list tasks.
     * @allow (create) User with UID 'user123' can create a task with ownerId 'user123'.
     * @allow (update) User with UID 'user123' can update a task they own.
     * @allow (delete) User with UID 'user123' can delete a task they own.
     * @deny (create) User with UID 'user456' cannot create a task with ownerId 'user123'.
     * @deny (update) User with UID 'user456' cannot update a task owned by 'user123'.
     * @deny (delete) User with UID 'user456' cannot delete a task owned by 'user123'.
     * @principle Allows public reads but restricts writes to the task owner.
     */
    match /tasks/{taskId} {
      function isOwner(ownerId) {
        return request.auth.uid == ownerId;
      }

      function isExistingOwner(ownerId) {
        return isOwner(ownerId) && resource != null;
      }
      allow get: if true;
      allow list: if true;

      allow create: if request.resource.data.id == taskId && request.auth != null; // Enforce the id is immutable and the document exists
      allow update: if isExistingOwner(resource.data.id);
      allow delete: if isExistingOwner(resource.data.id);
    }

    /**
     * @description Grants public read access and owner-only write access to recurring tasks.
     * @path /recurringTasks/{recurringTaskId}
     * @allow (get) Any user can read any recurring task.
     * @allow (list) Any user can list recurring tasks.
     * @allow (create) User with UID 'user123' can create a recurring task with ownerId 'user123'.
     * @allow (update) User with UID 'user123' can update a recurring task they own.
     * @allow (delete) User with UID 'user123' can delete a recurring task they own.
     * @deny (create) User with UID 'user456' cannot create a recurring task with ownerId 'user123'.
     * @deny (update) User with UID 'user456' cannot update a recurring task owned by 'user123'.
     * @deny (delete) User with UID 'user456' cannot delete a recurring task owned by 'user123'.
     */
    match /recurringTasks/{recurringTaskId} {
        function isOwner(ownerId) {
          return request.auth.uid == ownerId;
        }

        function isExistingOwner(ownerId) {
          return isOwner(ownerId) && resource != null;
        }
        allow get: if true;
        allow list: if true;

        allow create: if request.resource.data.taskName != null && request.auth != null; // Enforce the id is immutable and the document exists
        allow update: if isExistingOwner(resource.data.taskName);
        allow delete: if isExistingOwner(resource.data.taskName);
    }

    /**
     * @description Grants public read access and owner-only write access to locations.
     * @path /locations/{locationId}
     * @allow (get) Any user can read any location.
     * @allow (list) Any user can list locations.
     * @allow (create) User with UID 'user123' can create a location with ownerId 'user123'.
     * @allow (update) User with UID 'user123' can update a location they own.
     * @allow (delete) User with UID 'user123' can delete a location they own.
     * @deny (create) User with UID 'user456' cannot create a location with ownerId 'user123'.
     * @deny (update) User with UID 'user456' cannot update a location owned by 'user123'.
     * @deny (delete) User with UID 'user456' cannot delete a location owned by 'user123'.
     */
    match /locations/{locationId} {
      function isOwner(ownerId) {
        return request.auth.uid == ownerId;
      }

      function isExistingOwner(ownerId) {
        return isOwner(ownerId) && resource != null;
      }
      allow get: if true;
      allow list: if true;
      allow create: if request.resource.data.locationName != null && request.auth != null; // Enforce the id is immutable and the document exists
      allow update: if isExistingOwner(resource.data.locationName);
      allow delete: if isExistingOwner(resource.data.locationName);
    }

    /**
     * @description Grants public read access and owner-only write access to categories.
     * @path /categories/{categoryId}
     * @allow (get) Any user can read any category.
     * @allow (list) Any user can list categories.
     * @allow (create) User with UID 'user123' can create a category with ownerId 'user123'.
     * @allow (update) User with UID 'user123' can update a category they own.
     * @allow (delete) User with UID 'user123' can delete a category they own.
     * @deny (create) User with UID 'user456' cannot create a category with ownerId 'user123'.
     * @deny (update) User with UID 'user456' cannot update a category owned by 'user123'.
     * @deny (delete) User with UID 'user456' cannot delete a category owned by 'user123'.
     */
    match /categories/{categoryId} {
      function isOwner(ownerId) {
        return request.auth.uid == ownerId;
      }

      function isExistingOwner(ownerId) {
        return isOwner(ownerId) && resource != null;
      }
      allow get: if true;
      allow list: if true;
      allow create: if request.resource.data.id == categoryId && request.auth != null; // Enforce the id is immutable and the document exists
      allow update: if isExistingOwner(resource.data.id);
      allow delete: if isExistingOwner(resource.data.id);
    }

    /**
     * @description Grants read access to settings for all authenticated users, but denies all write access.
     * @path /settings/appSettings
     * @allow (get) Any authenticated user can read the settings.
     * @deny (create) No one can create a new settings document.
     * @deny (update) No one can update the settings document.
     * @deny (delete) No one can delete the settings document.
     * @principle Restricts modification of system settings.
     */
    match /settings/appSettings {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isSignedIn();
      allow list: if false;

      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}