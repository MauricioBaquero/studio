/**
 * @file Firestore Security Rules
 * @description This ruleset enforces authentication for all read and write operations.
 *
 * Core Philosophy:
 * All data access is strictly limited to authenticated users. This is a basic security
 * posture suitable for prototyping and will be refined in later iterations.
 *
 * Data Structure:
 * - /teams/{teamId}: Stores team information.
 * - /users/{userId}: Stores user profiles.
 * - /locations/{locationId}: Stores facility locations.
 * - /teams/{teamId}/tasks/{taskId}: Stores tasks for each team.
 * - /teams/{teamId}/recurringTasks/{recurringTaskId}: Stores recurring tasks.
 * - /teams/{teamId}/categories/{categoryId}: Stores task categories.
 * - /teams/{teamId}/settings/appSettings: Stores team settings.
 *
 * Key Security Decisions:
 * - User listing is disallowed as a default security measure.
 * - All write operations require authentication.
 * - No data validation is performed beyond authentication.
 *
 * Denormalization for Authorization:
 * N/A - In this initial phase, the focus is on authentication. Further iterations
 * will introduce denormalization to avoid `get()` calls and improve performance.
 *
 * Structural Segregation:
 * N/A - No segregation of public vs. private data in this initial phase.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows authenticated users to read and write team data.
     * @path /teams/{teamId}
     * @allow (get) request.auth != null
     * @allow (create) request.auth != null
     * @deny (get) request.auth == null
     * @deny (create) request.auth == null
     * @principle Requires authentication for all access.
     */
    match /teams/{teamId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Allows authenticated users to read and write user data.
     * @path /users/{userId}
     * @allow (get) request.auth != null
     * @allow (create) request.auth.uid == userId
     * @deny (get) request.auth == null
     * @deny (create) request.auth.uid != userId
     * @principle Enforces document ownership for user profiles.
     */
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if request.auth.uid == userId;
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Allows authenticated users to read and write location data.
     * @path /locations/{locationId}
     * @allow (get) request.auth != null
     * @allow (create) request.auth != null
     * @deny (get) request.auth == null
     * @deny (create) request.auth == null
     * @principle Requires authentication for all access.
     */
    match /locations/{locationId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Allows authenticated users to read and write task data within a team.
     * @path /teams/{teamId}/tasks/{taskId}
     * @allow (get) request.auth != null
     * @allow (create) request.auth != null
     * @deny (get) request.auth == null
     * @deny (create) request.auth == null
     * @principle Requires authentication for all access.
     */
    match /teams/{teamId}/tasks/{taskId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Allows authenticated users to read and write recurring task data within a team.
     * @path /teams/{teamId}/recurringTasks/{recurringTaskId}
     * @allow (get) request.auth != null
     * @allow (create) request.auth != null
     * @deny (get) request.auth == null
     * @deny (create) request.auth == null
     * @principle Requires authentication for all access.
     */
    match /teams/{teamId}/recurringTasks/{recurringTaskId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Allows authenticated users to read and write category data within a team.
     * @path /teams/{teamId}/categories/{categoryId}
     * @allow (get) request.auth != null
     * @allow (create) request.auth != null
     * @deny (get) request.auth == null
     * @deny (create) request.auth == null
     * @principle Requires authentication for all access.
     */
    match /teams/{teamId}/categories/{categoryId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Allows authenticated users to read and write team settings.
     * @path /teams/{teamId}/settings/appSettings
     * @allow (get) request.auth != null
     * @allow (create) request.auth != null
     * @deny (get) request.auth == null
     * @deny (create) request.auth == null
     * @principle Requires authentication for all access.
     */
    match /teams/{teamId}/settings/appSettings {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // =================== Helper Functions ===================

    /**
     * @description Checks if the user is signed in.
     * @return {bool} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }
  }
}