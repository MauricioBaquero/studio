/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict user-ownership model for user profiles
 * and allows public read access to tasks, recurring tasks, locations, and categories.
 * Only authenticated users can create, update, or delete these entities, and they must
 * be the owners. System settings are read-only.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles, accessible only to the user themselves.
 * - /tasks/{taskId}: Stores tasks, publicly readable but owner-writable.
 * - /recurringTasks/{recurringTaskId}: Stores recurring tasks, publicly readable but owner-writable.
 * - /locations/{locationId}: Stores locations, publicly readable but owner-writable.
 * - /categories/{categoryId}: Stores categories, publicly readable but owner-writable.
 * - /settings/appSettings: Stores application settings, publicly readable, not writable via the client.
 *
 * Key Security Decisions:
 * - User listing is explicitly denied to protect user privacy.
 * - Tasks, recurringTasks, locations, and categories are publicly readable to facilitate
 *   application functionality, but write access is restricted to owners. The owner must
 *   be specified via an 'ownerId' field on the document.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Protects user profiles, ensuring only the user can access their own data.
     * @path /users/{userId}
     * @allow (create) User with uid 'user123' can create their profile.
     * @allow (get) User with uid 'user123' can read their profile.
     * @allow (update) User with uid 'user123' can update their profile.
     * @allow (delete) User with uid 'user123' can delete their profile.
     * @deny (create) User with uid 'user456' cannot create a profile for 'user123'.
     * @deny (get) User with uid 'user456' cannot read the profile of 'user123'.
     * @deny (update) User with uid 'user456' cannot update the profile of 'user123'.
     * @deny (delete) User with uid 'user456' cannot delete the profile of 'user123'.
     * @principle Enforces document ownership for all operations on user profiles.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Manages facility tasks, allowing public read access but restricting writes to owners.
     * @path /tasks/{taskId}
     * @allow (get) Any user can read any task.
     * @allow (list) Any user can list tasks.
     * @allow (create) User with uid 'user123' can create a task with ownerId 'user123'.
     * @allow (update) User with uid 'user123' can update a task they own (ownerId 'user123').
     * @allow (delete) User with uid 'user123' can delete a task they own (ownerId 'user123').
     * @deny (create) User with uid 'user456' cannot create a task with ownerId 'user123'.
     * @deny (update) User with uid 'user456' cannot update a task owned by 'user123'.
     * @deny (delete) User with uid 'user456' cannot delete a task owned by 'user123'.
     * @principle Allows public read access while enforcing document ownership for writes.
     */
    match /tasks/{taskId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.id == taskId;
      allow update: if isExistingOwner(resource.data.id);
      allow delete: if isExistingOwner(resource.data.id);
    }

    /**
     * @description Manages recurring tasks, allowing public read access but restricting writes to owners.
     * @path /recurringTasks/{recurringTaskId}
     * @allow (get) Any user can read any recurring task.
     * @allow (list) Any user can list recurring tasks.
     * @allow (create) User with uid 'user123' can create a recurring task with ownerId 'user123'.
     * @allow (update) User with uid 'user123' can update a recurring task they own (ownerId 'user123').
     * @allow (delete) User with uid 'user123' can delete a recurring task they own (ownerId 'user123').
     * @deny (create) User with uid 'user456' cannot create a recurring task with ownerId 'user123'.
     * @deny (update) User with uid 'user456' cannot update a recurring task owned by 'user123'.
     * @deny (delete) User with uid 'user456' cannot delete a recurring task owned by 'user123'.
     * @principle Allows public read access while enforcing document ownership for writes.
     */
    match /recurringTasks/{recurringTaskId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.taskName != null;
      allow update: if isExistingOwner(recurringTaskId);
      allow delete: if isExistingOwner(recurringTaskId);
    }

    /**
     * @description Manages facility locations, allowing public read access but restricting writes to owners.
     * @path /locations/{locationId}
     * @allow (get) Any user can read any location.
     * @allow (list) Any user can list locations.
     * @allow (create) User with uid 'user123' can create a location with ownerId 'user123'.
     * @allow (update) User with uid 'user123' can update a location they own (ownerId 'user123').
     * @allow (delete) User with uid 'user123' can delete a location they own (ownerId 'user123').
     * @deny (create) User with uid 'user456' cannot create a location with ownerId 'user123'.
     * @deny (update) User with uid 'user456' cannot update a location owned by 'user123'.
     * @deny (delete) User with uid 'user456' cannot delete a location owned by 'user123'.
     * @principle Allows public read access while enforcing document ownership for writes.
     */
    match /locations/{locationId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.locationName != null;
      allow update: if isExistingOwner(locationId);
      allow delete: if isExistingOwner(locationId);
    }

    /**
     * @description Manages task categories, allowing public read access but restricting writes to owners.
     * @path /categories/{categoryId}
     * @allow (get) Any user can read any category.
     * @allow (list) Any user can list categories.
     * @allow (create) User with uid 'user123' can create a category with ownerId 'user123'.
     * @allow (update) User with uid 'user123' can update a category they own (ownerId 'user123').
     * @allow (delete) User with uid 'user123' can delete a category they own (ownerId 'user123').
     * @deny (create) User with uid 'user456' cannot create a category with ownerId 'user123'.
     * @deny (update) User with uid 'user456' cannot update a category owned by 'user123'.
     * @deny (delete) User with uid 'user456' cannot delete a category owned by 'user123'.
     * @principle Allows public read access while enforcing document ownership for writes.
     */
    match /categories/{categoryId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.categoryName != null;
      allow update: if isExistingOwner(categoryId);
      allow delete: if isExistingOwner(categoryId);
    }

    /**
     * @description Protects application settings, allowing public read access but denying all client-side writes.
     * @path /settings/appSettings
     * @allow (get) Any user can read the application settings.
     * @deny (create) No user can create or overwrite the settings document.
     * @deny (update) No user can update the settings document.
     * @deny (delete) No user can delete the settings document.
     * @principle Restricts write access to system settings to prevent unauthorized modifications.
     */
    match /settings/appSettings {
      allow get: if true;
      allow list: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }

  // Helper function to determine if the user is signed in.
  function isSignedIn() {
    return request.auth != null;
  }

  // Helper function to determine if the user is the owner of the resource.
  function isOwner(userId) {
    return request.auth.uid == userId;
  }

    // Helper function to determine if the user is the owner of the resource, and the resource exists
  function isExistingOwner(resourceId) {
    return isSignedIn() && request.auth.uid == resourceId && resource != null;
  }
}