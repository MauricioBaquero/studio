/**
 * @fileoverview Firestore Security Rules.
 *
 * Core Philosophy:
 * This ruleset is in prototyping mode. All read and write operations are allowed for all authenticated users.
 * Authorization will be handled in the application code.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles.
 * - /tasks/{taskId}: Stores all tasks for the facility.
 * - /recurringTasks/{recurringTaskId}: Stores all recurring tasks.
 * - /locations/{locationId}: Stores all facility locations.
 * - /categories/{categoryId}: Stores all task categories and sub-categories.
 * - /settings/appSettings: Stores system-wide settings in a single document.
 *
 * Key Security Decisions:
 * - Access is completely open to authenticated users.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows any authenticated user to read and write user profiles.
     * @path /users/{userId}
     * @allow (get, list, create, update, delete) - Any authenticated user.
     * @deny (none) - This rule is completely open for authenticated users.
     * @principle Open access for prototyping.
     */
    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    /**
     * @description Allows any authenticated user to read and write tasks.
     * @path /tasks/{taskId}
     * @allow (get, list, create, update, delete) - Any authenticated user.
     * @deny (none) - This rule is completely open for authenticated users.
     * @principle Open access for prototyping.
     */
    match /tasks/{taskId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    /**
     * @description Allows any authenticated user to read and write recurring tasks.
     * @path /recurringTasks/{recurringTaskId}
     * @allow (get, list, create, update, delete) - Any authenticated user.
     * @deny (none) - This rule is completely open for authenticated users.
     * @principle Open access for prototyping.
     */
    match /recurringTasks/{recurringTaskId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    /**
     * @description Allows any authenticated user to read and write locations.
     * @path /locations/{locationId}
     * @allow (get, list, create, update, delete) - Any authenticated user.
     * @deny (none) - This rule is completely open for authenticated users.
     * @principle Open access for prototyping.
     */
    match /locations/{locationId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    /**
     * @description Allows any authenticated user to read and write categories.
     * @path /categories/{categoryId}
     * @allow (get, list, create, update, delete) - Any authenticated user.
     * @deny (none) - This rule is completely open for authenticated users.
     * @principle Open access for prototyping.
     */
    match /categories/{categoryId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    /**
     * @description Allows any authenticated user to read and write app settings.
     * @path /settings/appSettings
     * @allow (get, list, create, update, delete) - Any authenticated user.
     * @deny (none) - This rule is completely open for authenticated users.
     * @principle Open access for prototyping.
     */
    match /settings/appSettings {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }
  }

  function isSignedIn() {
    return request.auth != null;
  }
}