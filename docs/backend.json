
{
  "entities": {
    "Team": {
      "title": "Team",
      "type": "object",
      "description": "Represents a team, division, or department within the organization.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Team."
        },
        "name": {
          "type": "string",
          "description": "The name of the team (e.g., 'Parking Facilities')."
        },
        "department": {
          "type": "string",
          "description": "The name of the parent department (e.g., 'Transportation and Mobility')."
        }
      },
      "required": [
        "id",
        "name",
        "department"
      ]
    },
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a system user.",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Unique identifier for the User entity, from Firebase Auth."
        },
        "name": {
          "type": "string",
          "description": "The name of the user."
        },
        "email": {
          "type": "string",
          "description": "The email address of the user.",
          "format": "email"
        },
        "role": {
          "type": "string",
          "enum": [
            "Admin",
            "Coordinator",
            "Staff",
            "Viewer"
          ],
          "description": "The role of the user within their assigned team."
        },
        "teamId": {
          "type": "string",
          "description": "The ID of the team the user belongs to, or 'allTeams' for admins."
        }
      },
      "required": [
        "uid",
        "name",
        "email",
        "role",
        "teamId"
      ]
    },
    "Task": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Task",
      "type": "object",
      "description": "Represents a maintenance or facility task for a specific team.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Task."
        },
        "categoryId": {
          "type": "string",
          "description": "Reference to a Category within the team."
        },
        "description": {
          "type": "string",
          "description": "Detailed explanation of the task."
        },
        "locationId": {
          "type": "string",
          "description": "Reference to a Location."
        },
        "requestedCompletionDate": {
          "type": "string",
          "format": "date",
          "description": "The date by which the task completion is requested."
        },
        "submitToReviewDate": {
          "type": "string",
          "format": "date",
          "description": "The date the task was submitted for review (staff completion date)."
        },
        "actualCompletionDate": {
          "type": "string",
          "format": "date",
          "description": "The date the task was approved and officially completed."
        },
        "status": {
          "type": "string",
          "description": "The current status of the task."
        },
        "photos": {
          "type": "array",
          "description": "A list of photos associated with the task.",
          "items": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "description": "Public URL of the photo."
              },
              "path": {
                "type": "string",
                "description": "Storage path of the photo."
              },
              "createdAt": {
                "type": "string",
                "format": "date-time",
                "description": "The date the photo was uploaded."
              }
            },
            "required": [
              "url",
              "path",
              "createdAt"
            ]
          }
        },
        "emlAttachments": {
          "type": "array",
          "description": "A list of EML files associated with the task.",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Name of the EML file."
              },
              "url": {
                "type": "string",
                "description": "Public URL of the EML file."
              },
              "path": {
                "type": "string",
                "description": "Storage path of the EML file."
              },
              "createdAt": {
                "type": "string",
                "format": "date-time",
                "description": "The date the EML file was uploaded."
              }
            },
            "required": [
              "name",
              "url",
              "path",
              "createdAt"
            ]
          }
        },
        "creatorId": {
          "type": "string",
          "description": "The UID of the user who created the task."
        },
        "approvedBy": {
          "type": "string",
          "description": "The UID of the user who approved the task completion."
        },
        "assignedToIds": {
          "type": "array",
          "description": "A list of user IDs assigned to the task.",
          "items": {
            "type": "string"
          }
        },
        "unableToComplete": {
          "type": "boolean",
          "description": "Indicates if the task was marked as unable to be completed."
        },
        "resolution": {
          "type": "string",
          "description": "Details on how the task was resolved."
        }
      },
      "required": [
        "id",
        "categoryId",
        "description",
        "locationId",
        "requestedCompletionDate",
        "status",
        "creatorId"
      ]
    },
    "RecurringTask": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "RecurringTask",
      "type": "object",
      "description": "Represents a recurring task schedule for a team.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Recurring Task."
        },
        "title": {
          "type": "string",
          "description": "The name of the recurring task."
        },
        "categoryId": {
          "type": "string",
          "description": "Reference to a Category."
        },
        "locationId": {
          "type": "string",
          "description": "Reference to a Location."
        },
        "frequency": {
          "type": "string",
          "enum": [
            "Daily",
            "Weekly",
            "Bi-Weekly",
            "Monthly",
            "3 Months",
            "6 Months"
          ],
          "description": "The frequency of the task."
        },
        "dayOfWeek": {
          "type": "number",
          "description": "The day of the week for weekly tasks."
        },
        "weekOfMonth": {
          "type": "number",
          "description": "The week of the month for monthly tasks."
        },
        "lastCompleted": {
          "type": "array",
          "description": "A log of all completions for this task, including who completed it and when.",
          "items": {
            "type": "object",
            "properties": {
              "completedAt": {
                "type": "string",
                "format": "date-time",
                "description": "The timestamp of the completion."
              },
              "completedBy": {
                "type": "string",
                "description": "The UID of the user who completed the task."
              }
            },
            "required": [
              "completedAt",
              "completedBy"
            ]
          }
        },
        "assignedToIds": {
          "type": "array",
          "description": "A list of user IDs assigned to this task.",
          "items": {
            "type": "string"
          }
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "The date the recurring task was created."
        }
      },
      "required": [
        "id",
        "title",
        "categoryId",
        "locationId",
        "frequency"
      ]
    },
    "Location": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Location",
      "type": "object",
      "description": "Represents a facility location shared across the organization.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Location."
        },
        "name": {
          "type": "string",
          "description": "The name of the location."
        },
        "type": {
          "type": "string",
          "enum": [
            "City-Owned Parking Facilities",
            "Public Right-of-Way",
            "City-Owned Public Building",
            "Privately Owned Facility"
          ],
          "description": "The category/type of the location."
        },
        "numberOfFloors": {
          "type": "number",
          "description": "Number of floors at the location. Can be 0 or N/A."
        },
        "facilitySpecs": {
          "type": "array",
          "description": "A list of technical specifications for the facility.",
          "items": {
            "type": "object"
          }
        }
      },
      "required": [
        "id",
        "name"
      ]
    },
    "Category": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Category",
      "type": "object",
      "description": "Represents a task category for a team, which contains sub-categories.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Category."
        },
        "name": {
          "type": "string",
          "description": "The name of the category."
        },
        "color": {
          "type": "string",
          "description": "The color associated with the category."
        },
        "subcategories": {
          "type": "array",
          "description": "A list of sub-categories.",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "name"
            ]
          }
        }
      },
      "required": [
        "id",
        "name"
      ]
    },
    "Setting": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Setting",
      "type": "object",
      "description": "Represents system settings for a team.",
      "properties": {
        "completionDateRange": {
          "type": "number",
          "description": "The minimum number of days for task completion requests."
        },
        "recurringTaskCompletionDays": {
          "type": "number",
          "description": "Days in advance a weekly or monthly recurring task can be completed."
        }
      },
      "required": [
        "completionDateRange"
      ]
    }
  },
  "auth": {
    "providers": [
      "password"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/teams/{teamId}",
        "definition": {
          "entityName": "Team",
          "schema": {
            "$ref": "#/entities/Team"
          },
          "description": "Stores all teams/departments."
        }
      },
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "User",
          "schema": {
            "$ref": "#/entities/User"
          },
          "description": "Stores user profiles."
        }
      },
      {
        "path": "/locations/{locationId}",
        "definition": {
          "entityName": "Location",
          "schema": {
            "$ref": "#/entities/Location"
          },
          "description": "Stores all shared facility locations."
        }
      },
      {
        "path": "/teams/{teamId}/tasks/{taskId}",
        "definition": {
          "entityName": "Task",
          "schema": {
            "$ref": "#/entities/Task"
          },
          "description": "Stores all tasks for a specific team."
        }
      },
      {
        "path": "/teams/{teamId}/recurringTasks/{recurringTaskId}",
        "definition": {
          "entityName": "RecurringTask",
          "schema": {
            "$ref": "#/entities/RecurringTask"
          },
          "description": "Stores all recurring tasks for a specific team."
        }
      },
      {
        "path": "/teams/{teamId}/categories/{categoryId}",
        "definition": {
          "entityName": "Category",
          "schema": {
            "$ref": "#/entities/Category"
          },
          "description": "Stores all task categories for a specific team."
        }
      },
      {
        "path": "/teams/{teamId}/settings/appSettings",
        "definition": {
          "entityName": "Setting",
          "schema": {
            "$ref": "#/entities/Setting"
          },
          "description": "Stores team-specific settings."
        }
      }
    ]
  }
}
