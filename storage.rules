rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // This rule applies to all files in the bucket, including 'taskphotos' and 'eml'.
    // WARNING: This is insecure and not recommended for production.
    // This allows anyone to read and write to your storage bucket.
    match /{allPaths=**} {
      allow read, write;
    }
  }
}
