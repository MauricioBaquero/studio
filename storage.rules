
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Apply rules to all files in the bucket
    match /{allPaths=**} {
      // Allow read and write access to any authenticated user with a user profile
      allow read, write: if request.auth != null && exists(/databases/(default)/documents/users/$(request.auth.uid));
    }
  }
}
