rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // The path segment with a space must be in single quotes.
    match /'task photos'/{allPaths=**} {

      // Allow read access (get, list) if the user is signed in and has a user profile.
      // This covers Viewer, Staff, and Admin roles.
      function isSignedInAndHasProfile() {
        return request.auth != null && exists(/databases/(default)/documents/users/$(request.auth.uid));
      }

      // Allow write access (create, update, delete) if the user's role is 'Staff' or 'Admin'.
      function isStaffOrAdmin() {
        return get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['Admin', 'Staff'];
      }

      // Apply the rules
      allow read: if isSignedInAndHasProfile();
      allow write: if isStaffOrAdmin();
    }
  }
}
